# Python environment and caches
.venv/
__pycache__/
*.pyc

# PlatformIO build output and editor state (machine-specific paths)
.pio/
.vscode/

# MATLAB / Simulink generated files
*.asv
*.slxc
*.mexw64
slprj/
par_mdl_ref/

# LaTeX build files (the compiled report PDF is tracked)
report/*.aux
report/*.log
report/*.out
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
report/*.toc

# Per-machine settings
local_profile.json
.claude/settings.local.json

# SolidWorks lock/temp files
~$*

# Unreal Engine build output (regenerated by twin/run_twin.ps1)
twin/RIPTwin/Binaries/
twin/RIPTwin/Intermediate/
twin/RIPTwin/Saved/
twin/RIPTwin/DerivedDataCache/
twin/RIPTwin/.vs/
twin/RIPTwin/*.sln

# MATLAB workspace dumps
matlab.mat

# Packaged builds (Unreal twin)
dist/

# Unreal packaging output (twin/package_twin.ps1)
twin/RIPTwin/Build/

# Furuta Lab run-time output (recordings in data/runs and data/captures are committed)
data/logs/
data/matlab-jobs/
data/estimation/last.txt

# Local tool settings
.claude/
